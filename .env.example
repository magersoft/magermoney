# apps/api
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# At least one of SUPABASE_URL (JWKS, ES256/RS256) or SUPABASE_JWT_SECRET
# (HS256 fallback) must be set, or the API refuses to boot.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
CRON_SECRET=change-me
# Comma-separated origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173
# Set to true on preview deployments to also allow https://*.vercel.app.
ALLOW_VERCEL_PREVIEWS=false
FIAT_RATES_URL=https://open.er-api.com/v6/latest/USD
CRYPTO_RATES_URL=https://api.coingecko.com/api/v3/simple/price
# apps/web
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:3000
